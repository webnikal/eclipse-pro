+"""Eclipse Pro animated splash screen (frameless, no title bar)."""
+
+import os
+
+from PyQt6.QtCore import Qt
+from PyQt6.QtGui import QMovie
+from PyQt6.QtWidgets import QLabel, QVBoxLayout, QWidget
+
+
+class EclipseSplash(QWidget):
+    """Borderless animated splash shown while Eclipse Pro loads."""
+
+    def __init__(self, gif_path):
+        super().__init__(
+            None,
+            Qt.WindowType.SplashScreen | Qt.WindowType.FramelessWindowHint
+        )
+        # No window frame, no title bar, stays on top while loading
+        self.setWindowFlag(Qt.WindowType.WindowStaysOnTopHint, True)
+
+        layout = QVBoxLayout(self)
+        layout.setContentsMargins(0, 0, 0, 0)
+
+        self.label = QLabel()
+        self.label.setAlignment(Qt.AlignmentFlag.AlignCenter)
+        self.movie = QMovie(gif_path)
+        self.label.setMovie(self.movie)
+        layout.addWidget(self.label)
+        self.movie.start()
+
+        # Size the window to the animation
+        self.movie.jumpToFrame(0)
+        pixmap = self.movie.currentPixmap()
+        if not pixmap.isNull():
+            self.label.setFixedSize(pixmap.size())
+        self.adjustSize()
+
+        # Center on the primary screen
+        screen = self.screen()
+        if screen:
+            geo = screen.availableGeometry()
+            self.move(
+                geo.center().x() - self.width() // 2,
+                geo.center().y() - self.height() // 2,
+            )
+
+    def close_splash(self):
+        """Stop the animation and close."""
+        try:
+            self.movie.stop()
+        except Exception:
+            pass
+        self.close()
