+from qt_api import QColor
+
+from themes.humanity.styles import HumanityDarkTimelineTheme
+from windows.views.timeline_backend.theme import _icon
+
+
+class EclipseTimelineTheme(HumanityDarkTimelineTheme):
+    """Eclipse timeline theme - Premiere Pro style dark colors."""
+
+    def __init__(self):
+        super().__init__()
+
+        # Keep labels proportional to the application font and user UI scale.
+        self.label_font_scale = 0.9
