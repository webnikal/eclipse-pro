@@ -0,0 +1,13 @@
+@echo off
+REM Eclipse Pro launcher (run from source on Windows)
+REM Requires: Python 3.11+, PyQt6 (pip install -r requirements.txt),
+REM and libopenshot + libopenshot-audio built/installed (see BUILD-WINDOWS.md)
+
+setlocal
+cd /d %~dp0
+
+REM If you built libopenshot but did not install it, uncomment and set:
+REM set PYTHONPATH=C:\path\to\libopenshot\build\bin\bindings\python;%PYTHONPATH%
+
+python src\launch.py %*
+endlocal
