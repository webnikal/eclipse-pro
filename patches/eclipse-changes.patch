+        self.keyframe_panel_marker_border   = QColor("#9CCBFF")
+
+        # ── Clip ──────────────────────────────────────────────────────────
+        # Premiere Pro style: video clips blue, audio clips green
+        self.clip.background    = QColor("#3D6EA8")
+        self.clip.background2   = QColor("#2C5484")
+        self.clip.top_overlay   = QColor(255, 255, 255, 12)
+        self.clip.top_overlay2  = QColor(255, 255, 255, 0)
+        self.clip.border_color  = QColor("#5A8FC4")
+        self.clip.border_radius = 4
+        self.clip.border_width  = 1.5
+        self.clip.font_color    = QColor("#FFFFFF")
+        self.clip.font_size     = 9
+        self.clip.height        = 58
