+        self.playhead_color         = QColor("#4DA3FF")
+        self.playhead_width         = 2.0
+        self.clip_selected          = QColor("#4DA3FF")
+        self.selection              = QColor(77, 163, 255, 90)
+        self.selection_border       = QColor(77, 163, 255, 140)
+        self.selection_border_width = 1.0
+        self.playback_cache_color   = QColor("#4DA3FF")
+        self.playback_cache_height  = 5.0
+        self.ruler_name_background  = QColor("#232323")
+        self.ruler_name_background2 = QColor()
+        self.scrollbar_handle       = QColor("#4DA3FF")
+        self.scrollbar_track        = QColor("#1A1A1A")
+        self.scrollbar_width        = 6
+        self.waveform_color         = QColor("#4DA3FF")
+        self.waveform_peak_color    = QColor(77, 163, 255, 128)
+        self.keyframe_fill          = QColor("#4DA3FF")
+        self.keyframe_border        = QColor("#FFFFFF")
+        self.keyframe_panel_property_bg      = QColor("#232323")
+        self.keyframe_panel_curve_color      = QColor("#4DA3FF")
+        self.keyframe_panel_marker_fill      = QColor("#4DA3FF")
+        self.keyframe_panel_marker_border   = QColor("#9CCBFF")
+
+        # ── Clip ──────────────────────────────────────────────────────────
+        # Premiere Pro style: video clips blue, audio clips green
+        self.clip.background    = QColor("#3D6EA8")
+        self.clip.background2   = QColor("#2C5484")
+        self.clip.top_overlay   = QColor(255, 255, 255, 12)
+        self.clip.top_overlay2  = QColor(255, 255, 255, 0)
+        self.clip.border_color  = QColor("#5A8FC4")
+        self.clip.border_radius = 4
+        self.clip.border_width  = 1.5
+        self.clip.font_color    = QColor("#FFFFFF")
+        self.clip.font_size     = 9
+        self.clip.height        = 58
+
+        # ── Track ─────────────────────────────────────────────────────────
+        self.track.background               = QColor("#232323")
+        self.track.background2              = QColor("#262626")
+        self.track.border_color             = QColor("#3A3A3A")
+        self.track.height                   = 56
+        self.track.gap                      = 6
+        self.track.font_color               = QColor("#D8D8D8")
+        self.track.name_background          = QColor("#232323")
+        self.track.name_border_color        = QColor("#4DA3FF")
+        self.track.name_border_top_color    = QColor("#3A3A3A")
+        self.track.name_border_bottom_color = QColor("#3A3A3A")
+        self.track.name_border_right_color  = QColor("#4A4A4A")
+
+        # ── Transition ────────────────────────────────────────────────────
+        self.transition.background   = QColor("#7A5CC9")
+        self.transition.background2  = QColor("#5E44A8")
+        self.transition.border_color = QColor("#9A7FE0")
+
+        # ── Ruler ─────────────────────────────────────────────────────────
+        self.ruler.background   = QColor("#232323")
+        self.ruler.background2  = QColor()
