+    // Internal: stash the latest frame from the renderer's present() signal.
+    // Runs on the player thread; guarded by QMutex for cross-thread polling.
+    void QtPlayer::onFramePresent(const QImage &image) {
+    	if (image.isNull())
+    	    return;
+    	QMutexLocker lock(&frame_mutex);
+    	last_frame = image.convertToFormat(QImage::Format_RGBA8888);
+    	frame_dirty = true;
+    }
+
+    // Thread-safe: copy the latest preview frame into the caller's buffer.
+    // ABI-safe alternative to SetQWidget() - only raw bytes cross the boundary.
+    int QtPlayer::CopyPreviewFrame(uintptr_t buffer_address, int buffer_size, int* out_w, int* out_h) {
+    	QMutexLocker lock(&frame_mutex);
+    	if (!frame_dirty || last_frame.isNull())
+    	    return 0;
+    	const int need = last_frame.width() * last_frame.height() * 4;
+    	if (!buffer_address || buffer_size < need)
+    	    return 0;
+    	memcpy(reinterpret_cast<void*>(buffer_address), last_frame.constBits(), need);
+    	if (out_w)
+    	    *out_w = last_frame.width();
+    	if (out_h)
+    	    *out_h = last_frame.height();
+    	frame_dirty = false;
+    	return need;
+    }
+
