diff --git a/src/Qt/VideoRenderer.cpp b/src/Qt/VideoRenderer.cpp
index fdedcdb..3cd030b 100644
--- a/src/Qt/VideoRenderer.cpp
+++ b/src/Qt/VideoRenderer.cpp
@@ -53,5 +53,32 @@ void VideoRenderer::render(std::shared_ptr<QImage> image)
     if (!image)
         return;
 
+    // Stash a copy for ABI-safe polling from Python (see CopyFrame).
+    // This never passes Qt objects across the binding boundary.
+    {
+        std::lock_guard<std::mutex> lock(frame_mutex);
+        last_frame = image->convertToFormat(QImage::Format_RGBA8888);
+        frame_dirty = true;
+    }
+
     emit present(*image);
 }
+
+/// Copy the latest rendered frame as raw RGBA bytes into the caller's buffer.
+/// Safe to call from any thread; only plain C types cross the ABI boundary.
+int VideoRenderer::CopyFrame(uintptr_t buffer_address, int buffer_size, int* out_w, int* out_h)
+{
+    std::lock_guard<std::mutex> lock(frame_mutex);
+    if (!frame_dirty || last_frame.isNull())
+        return 0;
+    const int need = last_frame.width() * last_frame.height() * 4;
+    if (!buffer_address || buffer_size < need)
+        return 0;
+    memcpy(reinterpret_cast<void*>(buffer_address), last_frame.constBits(), need);
+    if (out_w)
+        *out_w = last_frame.width();
+    if (out_h)
+        *out_h = last_frame.height();
+    frame_dirty = false;
+    return need;
+}
